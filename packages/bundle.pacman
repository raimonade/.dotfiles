# Linux (Arch/CachyOS) equivalent of packages/bundle: official repo packages.
# Installed by `dot init` via `sudo pacman -S --needed`. One package per line.
#
# Intentionally absent (handled elsewhere):
#   herdr, plannotator-tui  -> user-space installers in `dot` (~/.local/bin)
#   bun, vite-plus, pi      -> user-space installers in `dot`
#   gnu-sed                 -> GNU sed is already the system sed on Linux
#   mole, orbstack, raycast -> macOS only
#   zed                     -> install Zed yourself (stable: `pacman -S zed`)
ast-grep
bitwarden
btop
cloc
cloudflared
cmake
direnv
discord
doggo
fd
