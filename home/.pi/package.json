{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run check --workspace=pi-extension-opencode-cloudflare && npm run check --workspace=pi-save-md-extension && npm run check --workspace=pi-web-tools-extension && npm run typecheck:pi-ephemeral && npm run typecheck:pi-skill-toggle",
    "test:save-md": "npm run test --workspace=pi-save-md-extension",
    "test:web-tools": "npm run test --workspace=pi-web-tools-extension",
    "test:codex-fast-mode": "node --import tsx --test tests/codex-fast-mode.test.ts",
    "typecheck:pi-ephemeral": "npm run typecheck --workspace=pi-extension-ephemeral",
    "typecheck:pi-skill-toggle": "npm run typecheck --workspace=pi-skill-toggle"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@earendil-works/pi-tui": "^0.80.3",
    "typebox": "^1.1.38"
  }
}
