{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run check:web-tools && npm run typecheck:pi-ephemeral && npm run typecheck:pi-skill-toggle",
    "check:web-tools": "npm run check --workspace=pi-web-tools-extension",
    "test:web-tools": "npm run test --workspace=pi-web-tools-extension",
    "typecheck:pi-ephemeral": "npm run typecheck --workspace=pi-extension-ephemeral",
    "typecheck:pi-skill-toggle": "npm run typecheck --workspace=pi-skill-toggle"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.38"
  }
}
