{
  "name": ".pi",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run check:web-tools && npm run typecheck:pi-ephemeral",
    "check:web-tools": "npm run check --workspace=pi-web-tools-extension",
    "test:web-tools": "npm run test --workspace=pi-web-tools-extension",
    "typecheck:pi-ephemeral": "npm run typecheck --workspace=pi-extension-ephemeral"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.62.0",
    "@mariozechner/pi-coding-agent": "^0.62.0",
    "@mariozechner/pi-tui": "^0.62.0",
    "html-to-text": "^9.0.5",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
