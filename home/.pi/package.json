{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run check --workspace=pi-session-footer-extension && npm run test:worker-configuration-guard && npm run test:cloudflare-deployment-allowlist && npm run test:continue-after-compaction",
    "test:continue-after-compaction": "node --import tsx --test agent/extensions/tests/continue-after-compaction.test.ts",
    "test:worker-configuration-guard": "node --import tsx --test agent/extensions/tests/worker-configuration-guard.test.ts",
    "test:cloudflare-deployment-allowlist": "node --import tsx --test agent/extensions/tests/cloudflare-deployment-allowlist.test.ts",
    "test:session-footer": "npm run test --workspace=pi-session-footer-extension"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "^1.1.38"
  }
}
