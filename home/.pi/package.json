{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "npm run check --workspace=pi-extension-opencode-cloudflare && npm run check --workspace=pi-save-md-extension && npm run check --workspace=pi-session-footer-extension && npm run check --workspace=pi-web-tools-extension && npm run typecheck:pi-ephemeral && npm run typecheck:pi-skill-toggle && npm run test:pi-skill-toggle && npm run test:worker-configuration-guard",
    "test:save-md": "npm run test --workspace=pi-save-md-extension",
    "test:web-tools": "npm run test --workspace=pi-web-tools-extension",
    "test:codex-fast-mode": "node --import tsx --test tests/codex-fast-mode.test.ts",
    "test:worker-configuration-guard": "node --import tsx --test agent/extensions/tests/worker-configuration-guard.test.ts",
    "test:session-footer": "npm run test --workspace=pi-session-footer-extension",
    "test:pi-skill-toggle": "npm run test --workspace=pi-skill-toggle",
    "typecheck:pi-ephemeral": "npm run typecheck --workspace=pi-extension-ephemeral",
    "typecheck:pi-skill-toggle": "npm run typecheck --workspace=pi-skill-toggle"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "typebox": "^1.1.38"
  },
  "overrides": {
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    }
  }
}
