# Zenbones follows the macOS light/dark appearance.
theme = light:Zenbones Light,dark:Zenbones Dark

# Updates
auto-update-channel = tip

# Shell integration; launch Herdr explicitly from a project directory.
shell-integration = fish
quit-after-last-window-closed = true

# Font family
font-family = IBM Plex Mono
font-style = Regular
font-style-italic = Italic
font-style-bold = Bold
font-style-bold-italic = Bold Italic
font-size = 14
adjust-cell-height = 15%

# Opacity of split windows
unfocused-split-opacity = 0.97

# Set the background-opacity to be fully opaque
background-opacity = 1.0

# Cursor style
cursor-style = block
cursor-style-blink = false
cursor-color = #dd0455
cursor-text = #ffffff

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

# macos options
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

# Let shell set the tab title (process/cwd)
window-title-font-family = JetBrains Mono

# Window settings
window-colorspace = display-p3
window-padding-color = background
window-padding-balance = true
window-width = 90
window-height = 30
window-padding-x = 8
window-padding-y = 4,8

# Decrease scroll sensitivity
mouse-scroll-multiplier = 0.4

#Keybinds
keybind = alt+backspace=text:\x1b\x7f
