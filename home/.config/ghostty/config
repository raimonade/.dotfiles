# Ghostty theme
theme = Catppuccin Latte

# Updates
auto-update-channel = tip

# Shell integration; launch Herdr explicitly from a project directory.
shell-integration = fish
quit-after-last-window-closed = true

# Font family
font-family = JetBrains Mono
font-style = Regular
font-style-italic = Regular Italic
font-style-bold = Bold
font-style-bold-italic = Bold Italic

# Font features (programming ligatures)
font-feature = calt

# Font size
font-size = 13

# Opacity of split windows
unfocused-split-opacity = 0.97

# Set the background-opacity to be fully opaque
background-opacity = 1.0

# Cursor style
cursor-style-blink = true

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

# macos options
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

# Let shell set the tab title (process/cwd)
window-title-font-family = JetBrains Mono

# Window settings
window-colorspace = display-p3
window-padding-color = background
window-padding-balance = true
window-width = 90
window-height = 30
window-padding-x = 0
window-padding-y = 0

# Decrease scroll sensitivity
mouse-scroll-multiplier = 0.4

#Keybinds
keybind = alt+backspace=text:\x1b\x7f
