{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ast-grep:*)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(biome:*)",
      "Bash(bun:*)",
      "Bash(cargo:*)",
      "Bash(cat:*)",
      "Bash(cloc:*)",
      "Bash(cp:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(doggo:*)",
      "Bash(dot:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(fnm:*)",
      "Bash(fzf:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glab repo clone:*)",
      "Bash(glab:*)",
      "Bash(go:*)",
      "Bash(grep:*)",
      "Bash(gsed:*)",
      "Bash(gunzip:*)",
      "Bash(gzip:*)",
      "Bash(head:*)",
      "Bash(hostname)",
      "Bash(id)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm:*)",
      "Bash(open:*)",
      "Bash(pbcopy)",
      "Bash(pbpaste)",
      "Bash(pnpm:*)",
      "Bash(prettier:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sg:*)",
      "Bash(shellcheck:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(stow:*)",
      "Bash(tail:*)",
      "Bash(tar:*)",
      "Bash(tee:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(true)",
      "Bash(tsc:*)",
      "Bash(turbo:*)",
      "Bash(uname:*)",
      "Bash(uniq:*)",
      "Bash(unzip:*)",
      "Bash(vite:*)",
      "Bash(vitest:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(yarn:*)",
      "Bash(z:*)",
      "Bash(zip:*)",
      "Bash(zoxide:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__plugin_tracedecay_graph__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(secrets/*)"
    ],
    "ask": [
      "Bash(gh * approve*)",
      "Bash(gh * close*)",
      "Bash(gh * comment*)",
      "Bash(gh * delete*)",
      "Bash(gh * edit*)",
      "Bash(gh * merge*)",
      "Bash(gh * reopen*)",
      "Bash(gh * review*)",
      "Bash(glab * approve*)",
      "Bash(glab * close*)",
      "Bash(glab * comment*)",
      "Bash(glab * create*)",
      "Bash(glab * delete*)",
      "Bash(glab * edit*)",
      "Bash(glab * merge*)",
      "Bash(glab * reopen*)",
      "Bash(glab * review*)",
      "Bash(xargs:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "skillOverrides": {
    "codiff": "off",
    "plannotator-setup-goal": "off",
    "prompt-laboratory": "off",
    "tdd": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Ping.aiff 2>/dev/null & true"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v osascript >/dev/null; then osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'; elif command -v notify-send >/dev/null; then notify-send 'Claude Code' 'Claude Code needs your attention'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Glass.aiff 2>/dev/null & true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); user=$(whoami); dir=$(basename \"$(echo \"$input\" | jq -r '.workspace.current_dir')\"); branch=$(cd \"$(echo \"$input\" | jq -r '.workspace.current_dir')\" 2>/dev/null && git -c core.useBuiltinFSMonitor=false rev-parse --abbrev-ref HEAD 2>/dev/null || echo ''); model=$(echo \"$input\" | jq -r '.model.display_name'); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); status=\"$user in $dir\"; [ -n \"$branch\" ] && status=\"$status on $branch\"; status=\"$status | $model\"; [ -n \"$remaining\" ] && status=\"$status | context: ${remaining}% remaining\"; echo \"$status\""
  },
  "enabledPlugins": {
    "tracedecay@tracedecay": true,
    "paper-desktop@paper": true
  },
  "extraKnownMarketplaces": {
    "tracedecay": {
      "source": {
        "source": "directory",
        "path": "/Users/rkorzenevskis/.claude/plugins/marketplaces/tracedecay"
      }
    },
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(vp run dev:*)",
      "Bash(vp install)",
      "Bash(tracedecay tool:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(az webapp delete:*)",
      "Bash(tofu apply:*)"
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
