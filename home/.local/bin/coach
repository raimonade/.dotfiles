#!/usr/bin/env bash
# Coaching guards: a pull request needs a human-approved review of its exact diff, a session that
# committed needs a debrief, and every call, review, bypass and blocked attempt lands in one log
# that the weekly scorecard reads. Protocol: ~/.agents/COACHING.md.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/coach"
LOG="$STATE_DIR/log.jsonl"
MIN_BYPASS_REASON=15
RECALL_AFTER_SECONDS=$((2 * 86400))

die() { echo "coach: $*" >&2; exit 1; }
now() { date +%s; }

# Appends one event: `record <kind> key value [key value ...]`.
record() {
    local kind=$1 args=() filter='{ts: ($ts | tonumber), kind: $kind'
    shift
    while [ $# -gt 0 ]; do
        args+=(--arg "$1" "$2")
        filter+=", \"$1\": \$$1"
        shift 2
    done
    mkdir -p "$STATE_DIR"
    jq -cn --arg ts "$(now)" --arg kind "$kind" "${args[@]}" "$filter}" >> "$LOG"
}

# Exits 0 when the log holds an event matching the jq predicate over `.`.
logged() {
    [ -f "$LOG" ] || return 1
    jq -e -s "${@:2}" "any(.[]; $1)" "$LOG" > /dev/null
}

in_repo() { git -C "$1" rev-parse --is-inside-work-tree > /dev/null 2>&1; }

base_ref() {
    local dir=$1 ref
    ref=$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2> /dev/null) || ref=""
    for ref in "$ref" origin/main origin/master main master; do
        [ -n "$ref" ] && git -C "$dir" rev-parse -q --verify "$ref^{commit}" > /dev/null 2>&1 && { echo "$ref"; return; }
    done
    return 1
}

# Identity of the committed change against its merge base. Merging the base branch in keeps it
# stable; any new commit that alters the patch changes it.
local_diff_key() {
    local dir=$1 base merge_base
    base=$(base_ref "$dir") || return 1
    merge_base=$(git -C "$dir" merge-base "$base" HEAD) || return 1
    git -C "$dir" diff --quiet "$merge_base" HEAD && return 1
    echo "local:$(git -C "$dir" diff "$merge_base" HEAD | git hash-object --stdin)"
}

pr_diff_key() {
    local dir=$1 patch
    shift
    patch=$(cd "$dir" && gh pr diff "$@" 2> /dev/null) && [ -n "$patch" ] || return 1
    echo "pr:$(printf '%s\n' "$patch" | git hash-object --stdin)"
}

# The diff a `gh pr` command acts on: the local branch, unless it names a pull request whose head
# is some other commit.
target_key() {
    local dir=$1 pr=$2 repo=$3 gh_args=() head
    [ -n "$pr" ] && gh_args+=("$pr")
    [ -n "$repo" ] && gh_args+=(--repo "$repo")
    if [ -n "$pr" ]; then
        head=$(cd "$dir" && gh pr view "${gh_args[@]}" --json headRefOid -q .headRefOid 2> /dev/null) || head=""
        if [ -z "$head" ] || [ "$head" != "$(git -C "$dir" rev-parse HEAD 2> /dev/null)" ]; then
            pr_diff_key "$dir" "${gh_args[@]}"
            return
        fi
    fi
    local_diff_key "$dir"
}

cmd_review() {
    local dir=$PWD pr=${1:-} key decision
    in_repo "$dir" || die "not inside a git repository"
    key=$(target_key "$dir" "$pr" "") || die "no diff to review against the base branch"
    if [ -n "$pr" ]; then
        decision=$(plannotator review --json "$pr" | jq -r '.decision // empty')
    else
        decision=$(plannotator review --git --base "$(base_ref "$dir")" --json | jq -r '.decision // empty')
    fi
    [ "$decision" = approved ] || die "review ended '${decision:-closed}', no receipt written; fix the notes and review again"
    record review key "$key"
    echo "coach: review receipt recorded for $key"
}

cmd_bypass() {
    local dir=$PWD pr="" reason key
    [ "${1:-}" = --pr ] && { pr=${2:?--pr needs a number or URL}; shift 2; }
    reason="$*"
    # A bypass is a human decision: an agent's shell has no terminal on stdin.
    [ -t 0 ] || die "bypass must be typed by the user in their own terminal"
    [ "${#reason}" -ge "$MIN_BYPASS_REASON" ] || die "give a real reason (at least $MIN_BYPASS_REASON characters)"
    key=$(target_key "$dir" "$pr" "") || die "no diff to bypass"
    record bypass key "$key" reason "$reason"
    echo "coach: bypass logged for $key"
}

# `gh pr create|ready|merge` passes only with a review receipt or a logged bypass for its diff.
cmd_gate() {
    local dir="" command="" verb rest pr repo key word prev=""
    while [ $# -gt 0 ]; do
        case $1 in
            --cwd) dir=$2 ;;
            --command) command=$2 ;;
            *) die "gate: unknown option $1" ;;
        esac
        shift 2
    done
    local bypass_re='(^|[^[:alnum:]_-])coach[[:space:]]+bypass'
    local pr_re='(^|[^[:alnum:]_-])gh[[:space:]]+pr[[:space:]]+(create|ready|merge)([[:space:]]+([^;&|]*))?'
    if [[ $command =~ $bypass_re ]]; then
        echo "coach: only the user can bypass, from their own terminal. Run the review instead: coach review" >&2
        return 2
    fi
    [[ $command =~ $pr_re ]] || return 0
    verb=${BASH_REMATCH[2]} rest=${BASH_REMATCH[4]:-}
    in_repo "$dir" || return 0
    # shortcut: whitespace word split of the arguments; a quoted --body containing a bare number
    # or pull URL could be mistaken for the target. Parse with a real shell lexer if that bites.
    pr="" repo=""
    set -f
    for word in $rest; do
        case $word in
            [0-9]*) [ -z "$pr" ] && [[ $word =~ ^[0-9]+$ ]] && pr=$word ;;
            https://*/pull/[0-9]*) [ -z "$pr" ] && pr=$word ;;
            --repo=*) repo=${word#--repo=} ;;
        esac
        if [ "$prev" = -R ] || [ "$prev" = --repo ]; then repo=$word; fi
        prev=$word
    done
    set +f
    [ "$verb" = create ] && pr=""
    if ! key=$(target_key "$dir" "$pr" "$repo"); then
        echo "coach: cannot identify the diff for 'gh pr $verb' (no commits against the base branch, or gh failed)." >&2
        return 2
    fi
    if logged '.kind == "review" and .key == $key' --arg key "$key"; then
        record gate verb "$verb" key "$key" result reviewed
        return 0
    fi
    if logged '.kind == "bypass" and .key == $key' --arg key "$key"; then
        record gate verb "$verb" key "$key" result bypassed
        return 0
    fi
    record gate verb "$verb" key "$key" result blocked
    cat >&2 << EOF
coach: 'gh pr $verb' blocked. No human-approved review of this exact diff ($key).
Run: coach review${pr:+ $pr}   (opens Plannotator; the receipt is written when the user clicks Approve)
Do not work around this. If the user wants to skip review they run, in their own terminal:
  coach bypass${pr:+ --pr $pr} "<reason>"
EOF
    return 2
}

cmd_call() {
    local topic="" mine="" agent="" verdict="" why=""
    while [ $# -gt 0 ]; do
        case $1 in
            --topic) topic=$2 ;; --mine) mine=$2 ;; --agent) agent=$2 ;;
            --verdict) verdict=$2 ;; --why) why=$2 ;;
            *) die "call: unknown option $1" ;;
        esac
        shift 2
    done
    [ -n "$topic" ] && [ -n "$mine" ] && [ -n "$agent" ] || die "call needs --topic, --mine and --agent"
    case $verdict in match | partial | miss) ;; *) die "--verdict is match, partial or miss" ;; esac
    record call topic "$topic" mine "$mine" agent "$agent" verdict "$verdict" why "$why"
}

cmd_debrief() {
    local session=${COACH_SESSION:-} decision="" call="" right="" concept="" pointer="" delegated=false
    while [ $# -gt 0 ]; do
        case $1 in
            --delegated) delegated=true; shift; continue ;;
            --session) session=$2 ;; --decision) decision=$2 ;; --call) call=$2 ;;
            --right) right=$2 ;; --concept) concept=$2 ;; --pointer) pointer=$2 ;;
            *) die "debrief: unknown option $1" ;;
        esac
        shift 2
    done
    [ -n "$decision" ] && [ -n "$concept" ] || die "debrief needs --decision and --concept"
    [ "$delegated" = true ] || [ -n "$call" ] || die "debrief needs the user's --call, or --delegated when no user took part"
    record debrief session "$session" decision "$decision" call "$call" right "$right" \
        concept "$concept" pointer "$pointer" delegated "$delegated"
}

cmd_recall() {
    local concept="" result=""
    while [ $# -gt 0 ]; do
        case $1 in
            --concept) concept=$2 ;; --result) result=$2 ;;
            *) die "recall: unknown option $1" ;;
        esac
        shift 2
    done
    [ -n "$concept" ] || die "recall needs --concept"
    case $result in pass | fail) ;; *) die "--result is pass or fail" ;; esac
    record recall concept "$concept" result "$result"
}

# The debriefed concept most in need of a spaced question: old enough, then least recalled.
cmd_question() {
    [ -f "$LOG" ] || return 0
    jq -r -s --argjson cutoff "$(($(now) - RECALL_AFTER_SECONDS))" '
        (map(select(.kind == "recall" and .result == "pass")) | group_by(.concept)
            | map({key: .[0].concept, value: length}) | from_entries) as $passes
        | map(select(.kind == "debrief" and .ts <= $cutoff)) | unique_by(.concept)
        | sort_by([($passes[.concept] // 0), .ts]) | .[0] // empty
        | "\(.concept)\t\(.pointer)"' "$LOG"
}

cmd_scorecard() {
    local days=7 since
    [ "${1:-}" = --days ] && days=${2:?--days needs a number}
    since=$(($(now) - days * 86400))
    [ -f "$LOG" ] || { echo "coach: nothing logged yet"; return 0; }
    jq -r -s --argjson since "$since" --arg days "$days" '
        map(select(.ts >= $since)) as $e
        | ($e | map(select(.kind == "call"))) as $calls
        | ($e | map(select(.kind == "debrief"))) as $debriefs
        | ($e | map(select(.kind == "recall"))) as $recalls
        | ($e | map(select(.kind == "bypass"))) as $bypasses
        | ($e | map(select(.kind == "gate"))) as $gates
        | def count(f): map(select(f)) | length;
        "Coaching scorecard, last \($days) days",
        "Calls made first:   \($calls | length)  (match \($calls | count(.verdict == "match")), partial \($calls | count(.verdict == "partial")), miss \($calls | count(.verdict == "miss")))",
        "Match rate:         \(if ($calls | length) == 0 then "n/a" else "\(($calls | count(.verdict == "match")) * 100 / ($calls | length) | floor)%" end)",
        "Diffs reviewed:     \($e | count(.kind == "review"))",
        "PR gates:           reviewed \($gates | count(.result == "reviewed")), bypassed \($gates | count(.result == "bypassed")), blocked attempts \($gates | count(.result == "blocked"))",
        "Debriefs:           \($debriefs | count(.delegated != "true")) with your call, \($debriefs | count(.delegated == "true")) delegated without one",
        "Recall questions:   pass \($recalls | count(.result == "pass")), fail \($recalls | count(.result == "fail"))",
        "Bypasses:           \($bypasses | length)",
        ($bypasses[] | "  - \(.reason)"),
        "Misses worth rereading:",
        ($calls[] | select(.verdict != "match") | "  - \(.topic): you said \(.mine); better was \(.agent)\(if .why != "" then " (\(.why))" else "" end)"),
        "Concepts this period:",
        ($debriefs | unique_by(.concept)[] | "  - \(.concept)\(if .pointer != "" then "  -> \(.pointer)" else "" end)")
    ' "$LOG"
    record scorecard days "$days"
}

hook_pretooluse() {
    local input=$1
    [ "$(jq -r '.tool_name // empty' <<< "$input")" = Bash ] || return 0
    cmd_gate --cwd "$(jq -r '.cwd // empty' <<< "$input")" --command "$(jq -r '.tool_input.command // empty' <<< "$input")"
}

hook_sessionstart() {
    local input=$1 session dir question
    session=$(jq -r '.session_id // empty' <<< "$input")
    dir=$(jq -r '.cwd // empty' <<< "$input")
    if [ -n "$session" ] && in_repo "$dir" && ! logged '.kind == "session" and .session == $s' --arg s "$session"; then
        record session session "$session" head "$(git -C "$dir" rev-parse HEAD 2> /dev/null || echo none)"
    fi
    [ "$(jq -r '.source // "startup"' <<< "$input")" = startup ] || return 0
    question=$(cmd_question)
    if [ -n "$question" ]; then
        printf 'Coaching: before starting work, ask the user one recall question on "%s" (%s). Record the result with `coach recall --concept ... --result pass|fail`.\n' \
            "${question%%$'\t'*}" "${question#*$'\t'}"
    fi
    # Friday onward, once per ISO week.
    if [ "$(date +%u)" -ge 5 ] && ! logged '.kind == "scorecard" and .ts >= $since' --argjson since "$(($(now) - 4 * 86400))"; then
        echo 'Coaching: the weekly scorecard is due. Run `coach scorecard` and show the user its output before other work.'
    fi
}

# A session that moved HEAD ends with one debrief.
hook_stop() {
    local input=$1 session dir start
    [ "$(jq -r '.stop_hook_active // false' <<< "$input")" = true ] && return 0
    session=$(jq -r '.session_id // empty' <<< "$input")
    dir=$(jq -r '.cwd // empty' <<< "$input")
    [ -n "$session" ] && [ -f "$LOG" ] && in_repo "$dir" || return 0
    start=$(jq -r -s --arg s "$session" 'map(select(.kind == "session" and .session == $s)) | .[0].head // empty' "$LOG")
    [ -n "$start" ] || return 0
    [ "$start" != "$(git -C "$dir" rev-parse HEAD 2> /dev/null || echo none)" ] || return 0
    logged '.kind == "debrief" and .session == $s' --arg s "$session" && return 0
    cat >&2 << EOF
coach: this session committed code and has no debrief. Draft three lines, show them to the user, and ask for their own call on the decision; then record it:
  coach debrief --session $session --decision "<the decision that mattered>" --call "<what the user said they would do>" --right "<what was right and why>" --concept "<one concept worth knowing>" --pointer "<file:line or doc to read>"
A delegated or unattended session with no user to ask records the same with --delegated instead of --call.
EOF
    return 2
}

cmd_hook() {
    local event=${1:-} input
    input=$(cat)
    case $event in
        pretooluse) hook_pretooluse "$input" ;;
        sessionstart) hook_sessionstart "$input" ;;
        stop) hook_stop "$input" ;;
        *) die "hook: unknown event '$event'" ;;
    esac
}

usage() {
    cat << 'EOF'
Usage: coach <command>
  review [PR]              Open Plannotator on the diff; Approve writes the review receipt
  bypass [--pr PR] REASON  Skip review for this diff (user's terminal only; logged)
  call --topic T --mine M --agent A --verdict match|partial|miss [--why W]
  debrief --decision D --call C --right R --concept K --pointer P [--session S] [--delegated]
  recall --concept K --result pass|fail
  question                 Concept due for a recall question
  scorecard [--days N]     Weekly numbers
  gate --cwd DIR --command CMD
  hook pretooluse|sessionstart|stop
EOF
}

main() {
    local command=${1:-}
    [ $# -gt 0 ] && shift
    case $command in
        review | bypass | gate | call | debrief | recall | question | scorecard | hook) "cmd_$command" "$@" ;;
        "" | -h | --help | help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
