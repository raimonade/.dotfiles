home/.agents/skills/ui/

# Python
__pycache__/
*.pyc

# Plannotator runtime/state (keep config tracked)
home/.plannotator/*
!home/.plannotator/config.json

# Herdr runtime/state (installed plugin sources are tracked in plugins.txt)
home/.config/herdr/*.log
home/.config/herdr/session-history.json
home/.config/herdr/session.json
home/.config/herdr/release-notes.json
home/.config/herdr/plugins.json
home/.config/herdr/plugins/
home/.config/herdr/.plugins.lock
home/.config/herdr/session-snapshots/
home/.config/herdr/*.sock
home/.config/herdr/*.sock.*

# local state / runtime (not config); bin/ and lib/ hold tracked scripts
home/.local/*
!home/.local/bin/
!home/.local/lib/
home/.config/zed/prompts/

# pi agent runtime/state (keep settings + customization resources tracked)
home/.pi/agent/*
home/.pi/todos/*
home/.pi/.pi/
home/.pi/pi-acp/
home/.pi/ephemeral/
home/.pi/plans/
.pi/todos/*

# pi MCP adapter runtime/secrets
home/.pi/agent/mcp-oauth/
home/.pi/agent/mcp-cache.json
home/.pi/agent/mcp-npx-cache.json
home/.pi/agent/mcp-auth.json
home/.local/share/pi/mcp-auth.json

!home/.pi/agent/tsconfig.json
!home/.pi/agent/package.json
!home/.pi/agent/cloak.json
!home/.pi/agent/claude-bridge.json
!home/.pi/agent/mcp.json
!home/.pi/agent/models.json
!home/.pi/agent/settings.json
!home/.pi/agent/cloudflare-deployment-allowlist.json
!home/.pi/agent/AGENTS.md
!home/.pi/agent/APPEND_SYSTEM.md
!home/.pi/agent/themes/
!home/.pi/agent/themes/*.json
!home/.pi/agent/chains/
!home/.pi/agent/chains/**
!home/.pi/agent/extensions/
!home/.pi/agent/extensions/**
!home/.pi/agent/prelude/
!home/.pi/agent/prelude/**

# Must follow the extension re-includes above.
home/.pi/agent/extensions/**/node_modules/

# Local work notes, linked from ~/.dotfiles-private (may contain employer details)
home/.pi/notes

# generated per machine by `tracedecay install --agent pi` (absolute binary path)
home/.pi/agent/extensions/tracedecay/
# platform engines fetched by impeccable on each host
home/.agents/skills/impeccable/scripts/bin/linux-x64/
home/.claude/skills/impeccable/scripts/bin/linux-x64/
home/.agents/skills/account-id-tags/

# Codex metadata the Plannotator installer regenerates on every update
home/.agents/skills/plannotator*/agents/
